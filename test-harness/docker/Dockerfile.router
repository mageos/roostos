# Stage 1: Build Debian packages from source
FROM ubuntu:24.04 AS builder

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    dpkg-dev \
    bash \
    coreutils \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /build
COPY scripts/ /build/scripts/
COPY roostos-sdk/ /build/roostos-sdk/
COPY roostos-engine/ /build/roostos-engine/
COPY roostos-web/ /build/roostos-web/
COPY roostos-ui/ /build/roostos-ui/
COPY roostos-timeguardd/ /build/roostos-timeguardd/
COPY roostos-debos/ /build/roostos-debos/
COPY debian/ /build/debian/

# Compile and package all modular .deb packages
RUN bash /build/scripts/build-all-debs.sh

# Stage 2: Final RoostOS Router Runtime Image
FROM ubuntu:24.04

ENV DEBIAN_FRONTEND=noninteractive
ENV PYTHONUNBUFFERED=1

# Install base system utilities and Python dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 \
    python3-pip \
    python3-venv \
    python3-yaml \
    python3-jinja2 \
    python3-cryptography \
    python3-psutil \
    python3-paho-mqtt \
    nftables \
    iproute2 \
    iptables \
    dbus \
    curl \
    procps \
    ca-certificates \
    iputils-ping \
    net-tools \
    git \
    && rm -rf /var/lib/apt/lists/*

# Install python runtime packages
RUN pip install --no-cache-dir --break-system-packages \
    pydantic \
    fastapi \
    uvicorn \
    httpx \
    dbus-next \
    python-jose \
    passlib

# Copy and install the built RoostOS Debian packages (Validating DEB installation & file placement)
COPY --from=builder /build/dist/debs/*.deb /tmp/debs/
RUN dpkg -i --force-depends /tmp/debs/*.deb \
    && apt-get install -y -f --no-install-recommends \
    && rm -rf /tmp/debs

COPY test-harness/docker/router-entrypoint.sh /usr/local/bin/router-entrypoint.sh
RUN chmod +x /usr/local/bin/router-entrypoint.sh

EXPOSE 8000 53 22

ENTRYPOINT ["/usr/local/bin/router-entrypoint.sh"]
