FROM debian:bookworm-slim

ENV DEBIAN_FRONTEND=noninteractive

RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    bind9-dnsutils \
    iproute2 \
    iputils-ping \
    netcat-openbsd \
    python3 \
    python3-paho-mqtt \
    procps \
    ca-certificates \
    && rm -rf /var/lib/apt/lists/*

# Copy and install client workstation Debian package (roostos-timeguardd) to validate installer
COPY dist/debs/ /tmp/debs/
RUN if ls /tmp/debs/roostos-timeguardd_*.deb 1>/dev/null 2>&1; then \
        dpkg -i /tmp/debs/roostos-timeguardd_*.deb || true; \
    fi && rm -rf /tmp/debs

COPY test-harness/docker/node-entrypoint.sh /usr/local/bin/node-entrypoint.sh
COPY test-harness/docker/wan-entrypoint.sh /usr/local/bin/wan-entrypoint.sh
RUN chmod +x /usr/local/bin/node-entrypoint.sh /usr/local/bin/wan-entrypoint.sh

ENTRYPOINT ["/usr/local/bin/node-entrypoint.sh"]
