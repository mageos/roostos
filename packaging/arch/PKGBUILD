# Maintainer: RoostOS Core Team <info@roostos.org>
pkgbase=roostos
pkgname=('roostos-sdk' 'roostos-engine' 'roostos-core' 'roostos-web' 'roostos-timeguardd' 'roostos-router')
pkgver=0.1.0
pkgrel=1
pkgdesc="RoostOS Family Router & Local Infrastructure Management System"
arch=('any')
url="https://roostos.org"
license=('Apache-2.0')
makedepends=('python')

_pyver() {
    python3 -c 'import sys; print(f"{sys.version_info.major}.{sys.version_info.minor}")'
}

package_roostos-sdk() {
    pkgdesc="Python SDK for RoostOS services and plugins"
    depends=('python' 'python-dbus-next')

    local py_site="/usr/lib/python$(_pyver)/site-packages"
    mkdir -p "$pkgdir/$py_site"
    cp -r "$SRC_DIR/roostos-sdk/src/roostos_sdk" "$pkgdir/$py_site/"
}

package_roostos-engine() {
    pkgdesc="Central domain REST API and configuration storage service for RoostOS"
    depends=('python' 'roostos-sdk' 'python-pydantic' 'python-fastapi' 'python-jwt' 'python-pyyaml')

    local py_site="/usr/lib/python$(_pyver)/site-packages"
    mkdir -p "$pkgdir/$py_site"
    mkdir -p "$pkgdir/usr/lib/systemd/system"
    mkdir -p "$pkgdir/etc/roostos"

    echo "$pkgver" > "$pkgdir/etc/roostos/version"
    cp -r "$SRC_DIR/roostos-engine/src/roostos_engine" "$pkgdir/$py_site/"
    cp "$SRC_DIR/packaging/common/systemd/roostos-engine.service" "$pkgdir/usr/lib/systemd/system/"
}

package_roostos-core() {
    pkgdesc="Local router management daemon applying firewall, DHCP, and network configs"
    depends=('python' 'roostos-sdk' 'roostos-engine' 'systemd' 'dbus' 'kea' 'nftables' 'iwd' 'python-paho-mqtt')
    install='roostos.install'

    mkdir -p "$pkgdir/usr/local/bin"
    mkdir -p "$pkgdir/usr/share/dbus-1/system.d"

    cp "$SRC_DIR/packaging/common/dbus/org.roostos.conf" "$pkgdir/usr/share/dbus-1/system.d/"
    cp "$SRC_DIR/roostos-engine/src/roostos_engine/templates/roost-dhcp-hook.sh" "$pkgdir/usr/local/bin/roost-dhcp-hook"
    chmod 755 "$pkgdir/usr/local/bin/roost-dhcp-hook"
}

package_roostos-web() {
    pkgdesc="Web administration panel and single-page management application for RoostOS"
    depends=('python' 'roostos-engine' 'python-fastapi' 'python-pam' 'python-jwt')

    local py_site="/usr/lib/python$(_pyver)/site-packages"
    mkdir -p "$pkgdir/$py_site"
    mkdir -p "$pkgdir/usr/share/roostos/web"
    mkdir -p "$pkgdir/usr/lib/systemd/system"

    cp -r "$SRC_DIR/roostos-web/src/roostos_web" "$pkgdir/$py_site/"
    cp -r "$SRC_DIR/roostos-ui/"* "$pkgdir/usr/share/roostos/web/"
    cp "$SRC_DIR/packaging/common/systemd/roostos-web.service" "$pkgdir/usr/lib/systemd/system/"
}

package_roostos-timeguardd() {
    pkgdesc="Screen time monitoring daemon for RoostOS client workstations"
    depends=('python' 'python-paho-mqtt' 'systemd' 'dbus')

    mkdir -p "$pkgdir/usr/local/bin"
    mkdir -p "$pkgdir/usr/lib/systemd/system"

    cp "$SRC_DIR/roostos-timeguardd/src/roostos_timeguardd/main.py" "$pkgdir/usr/local/bin/roostos-timeguardd"
    chmod 755 "$pkgdir/usr/local/bin/roostos-timeguardd"
    cp "$SRC_DIR/packaging/common/systemd/roostos-timeguardd.service" "$pkgdir/usr/lib/systemd/system/"
}

package_roostos-router() {
    pkgdesc="Standalone all-in-one RoostOS router distribution meta-package"
    depends=('roostos-sdk' 'roostos-engine' 'roostos-core' 'roostos-web')
}
