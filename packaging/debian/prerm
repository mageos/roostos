#!/bin/sh
set -e

case "$1" in
    remove|deconfigure|upgrade)
        echo "Stopping RoostOS services..."
        if [ -d /run/systemd/system ]; then
            systemctl stop roostos-engine.service || true
            systemctl stop roostos-web.service || true
        fi
        ;;

    upgrade|failed-upgrade)
        ;;

    *)
        echo "prerm called with unknown argument \`$1'" >&2
        exit 1
        ;;
esac

exit 0
